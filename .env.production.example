# Copy to a protected environment file and replace every change-me value.
# Use with: docker compose --env-file <file> -f compose.yaml -f compose.production.yaml up -d
COMPOSE_PROJECT_NAME=zhixiu
PUBLIC_WEB_ORIGIN=https://patterns.example.org
PUBLIC_CATALOG_API_BASE_URL=https://patterns.example.org/api/catalog/v1
PUBLIC_AI_API_BASE_URL=https://patterns.example.org/api/ai/v1
S3_ENDPOINT_URL=https://s3.example.org

CATALOG_ADMIN_TOKEN=change-me-long-random-catalog-token
CATALOG_ACTOR_SIGNING_SECRET=change-me-at-least-32-random-actor-signing-secret
AI_INTERNAL_TOKEN=change-me-long-random-ai-service-token
STUDIO_REQUESTS_PER_MINUTE=10
STUDIO_MAX_UPLOAD_BYTES=10485760
ADMIN_UI_USER=admin
ADMIN_UI_PASSWORD=change-me-strong-admin-password
AUTH_SESSION_SECRET=change-me-at-least-32-random-bytes
ADMIN_UI_ROLE=reviewer
ADMIN_TRUST_PROXY=false

POSTGRES_DB=zhixiu
POSTGRES_USER=zhixiu
POSTGRES_PASSWORD=change-me-url-safe-postgres-password
MINIO_ROOT_USER=change-me-bootstrap-user
MINIO_ROOT_PASSWORD=change-me-bootstrap-password
AI_S3_ACCESS_KEY=change-me-ai-access-key
AI_S3_SECRET_KEY=change-me-ai-storage-password
AI_S3_BUCKET=zhixiu-assets
AI_S3_REGION=us-east-1
AI_S3_PREFIX=production/ai-assets
CATALOG_S3_ACCESS_KEY=change-me-catalog-access-key
CATALOG_S3_SECRET_KEY=change-me-catalog-storage-password
CATALOG_S3_PREFIX=production/catalog-evidence
CATALOG_EVIDENCE_MAX_BYTES=10485760
