# Copy this file to .env and replace every change-me value before starting.
COMPOSE_PROJECT_NAME=zhixiu
PUBLIC_WEB_ORIGIN=http://localhost:3000
PUBLIC_CATALOG_API_BASE_URL=http://localhost:8001/api/v1
PUBLIC_AI_API_BASE_URL=http://localhost:8002/v1

CATALOG_ADMIN_TOKEN=change-me-long-random-catalog-token
CATALOG_ACTOR_SIGNING_SECRET=change-me-at-least-32-random-actor-signing-secret
AI_INTERNAL_TOKEN=change-me-long-random-ai-service-token
ADMIN_UI_USER=admin
ADMIN_UI_PASSWORD=change-me-strong-admin-password
AUTH_SESSION_SECRET=change-me-at-least-32-random-bytes
# Set to reviewer for accounts that must not publish.
ADMIN_UI_ROLE=publisher

POSTGRES_DB=zhixiu
POSTGRES_USER=zhixiu
POSTGRES_PASSWORD=change-me-strong-postgres-password
MINIO_ROOT_USER=zhixiu-minio
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
# Dedicated non-root MinIO identity used only by the AI service.
AI_S3_ACCESS_KEY=zhixiu-ai
AI_S3_SECRET_KEY=change-me-strong-ai-storage-password
AI_S3_BUCKET=zhixiu-assets
AI_S3_REGION=us-east-1
AI_S3_PREFIX=production/ai-assets
CATALOG_S3_ACCESS_KEY=zhixiu-catalog
CATALOG_S3_SECRET_KEY=change-me-strong-catalog-storage-password
CATALOG_S3_PREFIX=production/catalog-evidence
CATALOG_EVIDENCE_MAX_BYTES=10485760
# Local MinIO is plain HTTP. Set this to production only when the endpoint uses HTTPS.
AI_ENVIRONMENT=development
